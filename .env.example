# ─── Google Sheets (one spreadsheet per company) ─────────────────────────────
# IDs come from each sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
# Both sheets must be shared (Editor) with the service-account email below.
SPREADSHEET_ID_24C=14DgBXju1SP7JSruQP0xJgH9vPw54dPdb0vwRRPVtMBM
SPREADSHEET_ID_YOKOHAMA=1D4pFypDE1SMAY1uxuknymCXsXni9aeKiJvmL5ggmngQ

# (Legacy — still honoured as a fallback for 24C if SPREADSHEET_ID_24C is unset)
# GOOGLE_SPREADSHEET_ID=

# Base64-encoded service account JSON key (Google Cloud → IAM → Service Accounts → Keys → JSON)
#   macOS/Linux:  base64 -i key.json | tr -d '\n'
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Time zone used for every timestamp written to the sheets
APP_TIMEZONE=Asia/Manila
APP_TZ_OFFSET=+08:00

# ─── Auth (NextAuth / Google OAuth) — optional; staff can sign off with PINs ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# ─── Admin ───────────────────────────────────────────────────────────────────
# Google emails that count as admins when signed in (entries get Entry Type = ADMIN)
ADMIN_EMAILS=jamesdaly919@gmail.com,martinezkaye@gmail.com
# Passphrase for the Admin panel (add items / locations, run sheet setup)
ADMIN_PASSPHRASE=
